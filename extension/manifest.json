{
  "manifest_version": 3,
  "name": "有条有理 · 填表",
  "version": "0.1.0",
  "description": "用本机「有条有理」里的基本信息填官网表格：常见格子一次填完，填不了的标红，侧边栏点一下复制。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "有条有理 · 填表"
  }
}
